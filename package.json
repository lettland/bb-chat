{
  "name": "bbchat",
  "version": "0.1.3",
  "description": "BB in your terminal — a full TUI client for the BB coding-agent server.",
  "type": "module",
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/lettland/bb-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lettland/bb-chat.git"
  },
  "bugs": {
    "url": "https://github.com/lettland/bb-chat/issues"
  },
  "keywords": [
    "bb",
    "bb-app",
    "tui",
    "terminal",
    "cli",
    "coding-agent",
    "claude-code",
    "codex",
    "opencode",
    "opentui"
  ],
  "bin": {
    "bbchat": "./bin/bbchat.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build:binary": "bun build ./src/index.ts --compile --outfile dist/bbchat",
    "build:binaries": "bash scripts/build-binaries.sh",
    "install:local": "bash scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@opentui/core": "0.5.12",
    "bb-app": "0.43.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
